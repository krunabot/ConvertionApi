{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost",
      "url": "http://localhost:5173",
      "preLaunchTask": "Run Vite Frontend",
      "webRoot": "${workspaceFolder}/omni-convert-premium",
      "sourceMaps": true,
      "timeout": 30000
    },
    {
      "name": "SWA: Run omni-convert-premium",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:4280",
      "preLaunchTask": "swa: start omni-convert-premium",
      "webRoot": "${workspaceFolder}/omni-convert-premium",
      "timeout": 30000
    },
    {
      "name": ".NET Core Attach to Process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ],
  "compounds": []
}
