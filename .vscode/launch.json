{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Launch Vite and Chrome",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/omni-convert-premium",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/omni-convert-premium"
      }
    },
    {
      "name": "SWA: Run omni-convert-premium",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:4280",
      "preLaunchTask": "swa: start omni-convert-premium",
      "webRoot": "${workspaceFolder}/omni-convert-premium",
      "timeout": 30000
    },
    {
      "name": ".NET Core Attach to Process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ],
  "compounds": []
}
